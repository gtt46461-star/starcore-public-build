+UNSIGNED="$OUT_DIR/Starcore-Tianshu-V57.16.3-R4.0.3-903-unsigned-aligned.apk"
+"$ZIPALIGN" -f -p 4 "$TMP/unsigned.apk" "$UNSIGNED" > "$TMP/logs/zipalign.log" 2>&1 || fail ZIPALIGN
+"$AAPT2" dump badging "$UNSIGNED" > "$TMP/logs/aapt2-badging.log" || fail BADGING
+rg -q "package: name='com.ethk3.novaonepro' versionCode='577200903' versionName='V57.16.3-R4.0.3-903'" \
