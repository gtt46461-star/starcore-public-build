+package com.ethk3.novaonepro;
+
+import android.database.Cursor;
+import java.util.Arrays;
+import java.util.Comparator;
+
+/**
+ * Evidence governor that may re-rank the unique future SHADOW action surface.
+ *
+ * <p>It is deliberately much stricter than the Research keep/prune lifecycle. A formula needs at
+ * least 120 earlier future-live outcomes, Wilson95 lower bound at/above the random K3 baseline,
+ * useful probability error, and stable adjacent time blocks. Failed or absent evidence preserves
+ * the frozen Production ranker exactly. REAL authority is impossible in this class.
+ */
+public final class ResearchMainlineGovernorR903 {
+    public static final int MIN_FUTURE_N = 120;
+    public static final double MIN_WILSON_LOWER = 0.30d;
+    public static final double MAX_BRIER = 0.21d;
+    public static final double MAX_BLOCK_DRIFT = 0.12d;
+    /** Approximate two-sided family-wise correction for a pool of at most 96 candidates. */
+    public static final double SIMULTANEOUS_Z = 3.48d;
+    public static final boolean MAY_AUTHORIZE_REAL = false;
+
+    private ResearchMainlineGovernorR903() {}
+
+    public static Result govern(
+            DbStore store,
+            String targetIssue,
+            V51Models.PositionAction[] defaultRanked) {
+        if (store == null
+                || !TargetIssueResolver.isValid(targetIssue)
+                || defaultRanked == null
+                || defaultRanked.length != K3ActionSpaceEngine.TOTAL_ACTIONS)
+            return Result.fallback(defaultRanked, "INPUT_INVALID");
+        if (!V51BuildManifest.SHADOW_ONLY
+                || !V51BuildManifest.REAL_BET_HARD_DISABLED
+                || AppConfig.R36_REAL_BET_UNLOCK
+                || MAY_AUTHORIZE_REAL)
+            throw new IllegalStateException("R903_MAINLINE_REAL_BOUNDARY");
+        Candidate champion = certifiedChampion(store, targetIssue);
+        if (champion == null) return Result.fallback(defaultRanked, "NO_CERTIFIED_CHAMPION");
+        final ResearchStrategyDslEngine.Node formula;
+        try {
+            formula = ResearchStrategyDslEngine.parse(champion.formula);
+        } catch (Throwable invalid) {
+            return Result.fallback(defaultRanked, "CERTIFIED_FORMULA_INVALID");
+        }
+        try {
+            final double[] score = new double[defaultRanked.length];
+            Integer[] order = new Integer[defaultRanked.length];
+            FeatureView features = new FeatureView();
+            for (int i = 0; i < defaultRanked.length; i++) {
+                V51Models.PositionAction action = defaultRanked[i];
+                if (action == null) return Result.fallback(defaultRanked, "ACTION_NULL");
+                features.bind(action);
+                score[i] = finite(ResearchStrategyDslEngine.evaluate(formula, features));
+                order[i] = Integer.valueOf(i);
+            }
+            Arrays.sort(
+                    order,
+                    new Comparator<Integer>() {
+                        @Override
+                        public int compare(Integer left, Integer right) {
+                            int a = left.intValue(), b = right.intValue();
+                            int byScore = Double.compare(score[b], score[a]);
+                            if (byScore != 0) return byScore;
+                            int byOldRank = Integer.compare(defaultRanked[a].rank, defaultRanked[b].rank);
+                            return byOldRank != 0 ? byOldRank : Integer.compare(a, b);
+                        }
+                    });
+            V51Models.PositionAction[] reranked =
+                    new V51Models.PositionAction[defaultRanked.length];
+            for (int rank = 0; rank < order.length; rank++) {
+                int index = order[rank].intValue();
+                V51Models.PositionAction action = defaultRanked[index];
+                double margin = rank == 0 && order.length > 1
+                        ? score[index] - score[order[1].intValue()]
+                        : 0.0d;
+                reranked[index] =
+                        new V51Models.PositionAction(
+                                action.position,
+                                action.n1,
+                                action.n2,
+                                action.n3,
+                                action.n4,
+                                action.rawActionP,
+                                score[index],
+                                margin,
+                                action.thirdMargin,
+                                action.entropy,
+                                action.stability,
+                                action.metaFeatures,
+                                action.fingerprint,
+                                rank + 1,
+                                V51ChecksumEngine.sha256(
+                                        action.checksum + "|R903_GOVERNED|" + champion.id + '|'
+                                                + score[index] + '|' + (rank + 1)));
+            }
+            V51Models.PositionAction selected = reranked[order[0].intValue()];
+            return new Result(
+                    true,
+                    reranked,
+                    selected,
+                    "CERTIFIED_SHADOW_CHAMPION",
+                    champion.id,
+                    champion.n,
+                    champion.hitRate,
+                    champion.wilsonLower,
+                    champion.brier);
+        } catch (Throwable failure) {
+            return Result.fallback(
+                    defaultRanked, "GOVERNOR_FAILED_" + failure.getClass().getSimpleName());
+        }
+    }
+
+    private static Candidate certifiedChampion(DbStore store, String targetIssue) {
+        Cursor cursor = null;
+        Candidate best = null;
+        try {
+            cursor =
+                    store.readable()
+                            .rawQuery(
+                                    "SELECT c.candidate_id,c.canonical_spec,COUNT(o.target_issue),"
+                                            + "SUM(o.hit_label),AVG((o.probability-o.hit_label)*"
+                                            + "(o.probability-o.hit_label)),MAX(o.target_issue) FROM "
+                                            + "v57_research_candidate_r811 c JOIN "
+                                            + "v57_research_candidate_outcome_r811 o"
+                                            + " ON o.candidate_id=c.candidate_id"
+                                            + " WHERE c.candidate_type='FORMULA' AND c.runtime_executable=1"
+                                            + " AND c.status='KEEP_ACTIVE_R900' AND o.target_issue<?"
+                                            + " GROUP BY c.candidate_id,c.canonical_spec"
+                                            + " HAVING COUNT(o.target_issue)>=?"
+                                            + " ORDER BY (1.0*SUM(o.hit_label)/COUNT(o.target_issue)) DESC"
+                                            + " LIMIT 12",
+                                    new String[] {
+                                        targetIssue, String.valueOf(MIN_FUTURE_N)
+                                    });
+            while (cursor.moveToNext()) {
+                int n = cursor.getInt(2), hit = cursor.getInt(3);
+                double rate = n <= 0 ? 0.0d : ((double) hit) / n;
+                double lower = wilsonLower(hit, n);
+                double brier = cursor.getDouble(4);
+                String lastIssue = safe(cursor.getString(5));
+                if (lower < MIN_WILSON_LOWER
+                        || brier < 0.0d
+                        || brier > MAX_BRIER
+                        || !TargetIssueResolver.isValid(lastIssue)
+                        || TargetIssueResolver.compare(lastIssue, targetIssue) >= 0
+                        || !stableBlocks(store, safe(cursor.getString(0)), targetIssue)) continue;
+                Candidate current =
+                        new Candidate(
+                                safe(cursor.getString(0)), safe(cursor.getString(1)), n, rate, lower, brier);
+                if (best == null || quality(current) > quality(best)) best = current;
+            }
+            return best;
+        } catch (Throwable ignored) {
+            return null;
+        } finally {
+            if (cursor != null) cursor.close();
+        }
+    }
+
+    private static boolean stableBlocks(DbStore store, String candidateId, String targetIssue) {
+        Cursor cursor = null;
+        try {
+            cursor =
+                    store.readable()
+                            .rawQuery(
+                                    "SELECT hit_label FROM v57_research_candidate_outcome_r811"
+                                            + " WHERE candidate_id=? AND target_issue<?"
+                                            + " ORDER BY target_issue DESC LIMIT 60",
+                                    new String[] {candidateId, targetIssue});
+            int n = 0, recentHit = 0, priorHit = 0;
+            while (cursor.moveToNext()) {
+                if (n < 30) recentHit += cursor.getInt(0);
+                else priorHit += cursor.getInt(0);
+                n++;
+            }
+            if (n < 60) return false;
+            double recent = recentHit / 30.0d, prior = priorHit / 30.0d;
+            return recent >= 0.30d
+                    && prior >= 0.30d
+                    && Math.abs(recent - prior) <= MAX_BLOCK_DRIFT;
+        } finally {
+            if (cursor != null) cursor.close();
+        }
+    }
+
+    private static double wilsonLower(int hit, int n) {
+        if (n <= 0) return 0.0d;
+        double z = SIMULTANEOUS_Z, p = ((double) hit) / n, z2 = z * z;
+        double denominator = 1.0d + z2 / n;
+        double center = (p + z2 / (2.0d * n)) / denominator;
+        double half = z * Math.sqrt((p * (1.0d - p) + z2 / (4.0d * n)) / n) / denominator;
+        return Math.max(0.0d, center - half);
+    }
+
+    private static double quality(Candidate value) {
+        return value.wilsonLower + 0.10d * value.hitRate - 0.15d * value.brier;
+    }
+
+    private static double meta(double[] values, int index) {
+        return values != null && index >= 0 && index < values.length ? finite(values[index]) : 0.0d;
+    }
+
+    private static double finite(double value) {
+        return Double.isNaN(value) || Double.isInfinite(value) ? 0.0d : value;
+    }
+
+    private static String safe(String value) {
+        return value == null ? "" : value.trim();
+    }
+
+    private static final class FeatureView implements ResearchStrategyDslEngine.FeatureProvider {
+        V51Models.PositionAction action;
+        void bind(V51Models.PositionAction value) { action = value; }
+        public double value(String name) {
+            if (action == null) return 0.0d;
+            if ("rank_score".equals(name)) return action.rankScore;
+            if ("raw_action_p".equals(name)) return action.rawActionP;
+            if ("third_margin".equals(name)) return action.thirdMargin;
+            if ("entropy".equals(name)) return action.entropy;
+            if ("stability".equals(name)) return action.stability;
+            if ("assignment_support".equals(name)) return meta(action.metaFeatures, 15);
+            if ("window_consensus".equals(name)) return meta(action.metaFeatures, 20);
+            return 0.0d;
+        }
+    }
+
+    private static final class Candidate {
+        final String id, formula;
+        final int n;
+        final double hitRate, wilsonLower, brier;
+        Candidate(String id, String formula, int n, double rate, double lower, double brier) {
+            this.id = id; this.formula = formula; this.n = n;
+            hitRate = rate; wilsonLower = lower; this.brier = brier;
+        }
+    }
+
+    public static final class Result {
+        public final boolean applied;
+        public final V51Models.PositionAction[] actions;
+        public final V51Models.PositionAction rankOne;
+        public final String status, candidateId;
+        public final int futureN;
+        public final double hitRate, wilsonLower, brier;
+
+        Result(
+                boolean applied,
+                V51Models.PositionAction[] actions,
+                V51Models.PositionAction rankOne,
+                String status,
+                String candidateId,
+                int futureN,
+                double hitRate,
+                double wilsonLower,
+                double brier) {
+            this.applied = applied;
+            this.actions = actions;
+            this.rankOne = rankOne;
+            this.status = safe(status);
+            this.candidateId = safe(candidateId);
+            this.futureN = Math.max(0, futureN);
+            this.hitRate = hitRate;
+            this.wilsonLower = wilsonLower;
+            this.brier = brier;
+        }
+
+        static Result fallback(V51Models.PositionAction[] actions, String status) {
+            V51Models.PositionAction one = null;
+            if (actions != null) {
+                for (int i = 0; i < actions.length; i++)
+                    if (actions[i] != null && actions[i].rank == 1) { one = actions[i]; break; }
+            }
+            return new Result(false, actions, one, status, "", 0, 0.0d, 0.0d, -1.0d);
+        }
+    }
+}
