+unset PASS
+"$APKSIGNER" verify --verbose --print-certs "$SIGNED" > "$TMP/logs/apksigner-verify.log" 2>&1 || fail SIGN_VERIFY
+cert_sha=$(sed -n 's/^.*certificate SHA-256 digest: //p' "$TMP/logs/apksigner-verify.log" | head -n 1)
