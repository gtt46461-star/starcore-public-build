<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:navigationBarColor">@color/colorRoot</item>
        <item name="android:statusBarColor">@color/colorRoot</item>
        <item name="android:windowBackground">@drawable/bg_launch_screen</item>
        <item name="android:windowAnimationStyle">@style/NovaWindowAnimation</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NovaWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/fade_slide_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_slide_out</item>
    </style>

    <style name="TextMain">
        <item name="android:textColor">@color/colorTextMain</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextSub">
        <item name="android:textColor">@color/colorTextSub</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextMuted">
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/colorTextMain</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SectionCaption">
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="MetricLabel">
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MetricValue">
        <item name="android:textColor">@color/colorTextMain</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NovaButtonBase" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorTextMain</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NovaButton" parent="NovaButtonBase">
        <item name="android:background">@drawable/selector_button_primary</item>
    </style>

    <style name="NovaButtonSecondary" parent="NovaButtonBase">
        <item name="android:background">@drawable/selector_button_secondary</item>
    </style>

    <style name="NovaButtonDanger" parent="NovaButtonBase">
        <item name="android:background">@drawable/selector_button_danger</item>
    </style>

    <style name="NovaButtonQuiet" parent="NovaButtonBase">
        <item name="android:background">@drawable/selector_button_quiet</item>
    </style>

    <style name="ChipText">
        <item name="android:textColor">@color/colorInfo</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ConsoleText">
        <item name="android:textColor">@color/colorTextSub</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
