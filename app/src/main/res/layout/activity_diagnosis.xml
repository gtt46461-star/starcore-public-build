<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_app_canvas">
    <TextView android:id="@+id/txt_diagnosis_title" style="@style/CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diagnosis_title"/>
    <Button android:id="@+id/btn_diagnosis_copy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/action_copy_full"/>
    <Button android:id="@+id/btn_diagnosis_copy_all" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/action_copy_all_software"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="@drawable/bg_console" android:padding="10dp">
        <TextView android:id="@+id/txt_diagnosis_full" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/colorTextMain" android:textSize="13sp" android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
