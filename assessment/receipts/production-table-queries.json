{
  "sourceCommit": "69eab914678bc988b71f2d7ce2287ccf89bd49eb",
  "apkSha256": "a8ce8f811af22cd29b14fe46774c32a12565b9a1e5b44b2c801c5412e71ae51f",
  "runtimeSource": "final candidate production ResearchTableAdaptersR30R1.query(id), then the 16 table entries returned by three independent installed signed UI and SAF jobs",
  "classSha256": "ac06a444702553edb0578ee6a68d69e05b4b531fe228a86c3e9f53170fd8e0e0",
  "sql": {
    "T01": "SELECT run_id,dataset_hash,policy_hash,role,source_commit,source_revision,from_ordinal,through_ordinal,contract_hash,status,summary_json FROM r30r1_analysis_run ORDER BY recorded_at DESC,run_id",
    "T02": "SELECT atom_id,dataset_hash,n_select,missing_rate,state,definition,computed_at FROM r31_atom_score_visible ORDER BY atom_id",
    "T03": "SELECT policy_hash,target_issue,target_ordinal,position,probabilities,frozen_at,deadline_at,hit,settled_at,'FUTURE_READ_ONLY' AS role FROM r27_live_frozen ORDER BY target_ordinal DESC,policy_hash",
    "T04": "SELECT run_id,measure_key,kind,parent_hash,from_ordinal,to_ordinal,payload_json FROM r30r1_research_measure WHERE kind IN ('FAILURE_PRESCRIPTION','FAILURE_MEMORY','STRUCTURE_FORECAST_ERROR') ORDER BY run_id,measure_key",
    "T05": "SELECT run_id,measure_key,parent_hash,from_ordinal,to_ordinal,evaluated_calendar_issues,mean_gain,lower95,upper95,payload_json FROM r30r1_research_measure WHERE kind='ATOM_PAIRED_GAIN' ORDER BY run_id,measure_key",
    "T06": "SELECT run_id,measure_key,parent_hash,payload_json FROM r30r1_research_measure WHERE kind='MOLECULE_SYNERGY' ORDER BY run_id,measure_key",
    "T07": "SELECT dataset_hash,probe_set_hash,signature,kept_policy,dropped_policy,stage,recorded_at FROM r30_behavior_dup ORDER BY recorded_at DESC,kept_policy,dropped_policy",
    "T08": "SELECT generation,expert,proposal_json,policy_hash,recorded_at FROM r27_expert_proposal ORDER BY generation DESC,expert,policy_hash",
    "T09": "SELECT r.run_id,r.role,r.policy_hash,m.measure_key,m.kind,CASE m.kind WHEN 'OPERATOR_GAIN_COST' THEN 'PAIRED_TEN_CLASS_PROPER_GAIN_PER_ISSUE|AST_NODES' WHEN 'PARENT_CHILD_PAIRED' THEN 'FORMAL_READ_ONLY_VERDICT' WHEN 'RESEARCH_BUDGET' THEN 'SHARE_OF_RESEARCH_BUDGET'  ELSE 'HISTORICAL_UNIT_UNVERIFIED' END AS unit,CASE WHEN m.kind IN ('OPERATOR_GAIN_COST','PARENT_CHILD_PAIRED','RESEARCH_BUDGET') THEN 'CURRENT' ELSE 'HISTORICAL' END AS tier,m.mean_gain,m.payload_json FROM r30r1_analysis_run r JOIN r30r1_research_measure m ON m.run_id=r.run_id WHERE m.kind IN ('OPERATOR_GAIN_COST','PARENT_CHILD_PAIRED','RESEARCH_BUDGET','OPERATOR_COST','PARENT_CHILD_GAIN') ORDER BY r.recorded_at DESC,m.measure_key,r.run_id",
    "T10": "SELECT run_id,measure_key,parent_hash,payload_json FROM r30r1_research_measure WHERE kind='FUSION_COMPLEMENTARITY' ORDER BY run_id,measure_key",
    "T11": "SELECT target_ordinal,position,model_hash,history_hash,probabilities,probability_hash,trained_through_ordinal,model_available_at,feature_through_ordinal,frozen_at,deadline_at FROM r30_model_surface ORDER BY target_ordinal DESC,position,model_hash",
    "T12": "SELECT key AS policy_hash,payload_json,updated_at FROM r27_chart_cache WHERE panel_id='calibration-r30' ORDER BY key",
    "T13": "SELECT task_key,policy_hash,dataset_hash,block_id,state,verified,registration_state,registration_experiment_id,packet_json,result_json,'FORMAL_READ_ONLY' AS role FROM r30_frozen_confirm ORDER BY created_at DESC,task_key",
    "T14": "SELECT p.*,t.lane,t.status,t.blocked_reason FROM r30r1_task_progress p LEFT JOIN r26_task t ON t.task_id=p.task_id ORDER BY p.task_id",
    "T15": "SELECT p.proposal_id,p.run_id,p.parent_hash,p.kind,p.payload_json,p.state,p.reason,c.child_policy_hash,c.source_generation,c.consumer_version,c.receipt_hash,c.consumed_at FROM r30r1_proposal p LEFT JOIN r30r1_consume c ON c.proposal_id=p.proposal_id ORDER BY p.created_at DESC,p.proposal_id",
    "T16": "SELECT issue,decision_key,entry_point,original_allow,original_reason,certificate_active,items_json,source_json,recorded_at,'FORMAL_READ_ONLY' AS role FROM r30_decision_explain ORDER BY recorded_at DESC,issue,decision_key,entry_point"
  },
