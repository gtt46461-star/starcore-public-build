<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Diagnosis caught exception stacks" description="Only exception throw stacks for host Stub diagnosis" provider="R31 HOST diagnosis">
  <event name="jdk.JavaExceptionThrow">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
  </event>
</configuration>
