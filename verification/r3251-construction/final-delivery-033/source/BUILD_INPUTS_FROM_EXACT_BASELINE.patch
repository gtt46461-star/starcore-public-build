+package com.ethk3.novaonepro.strategyv2;
+import java.util.*;import java.sql.*;import java.nio.file.*;
+/** Actual SQLite counters + pure production report contracts. HOST synthetic mechanics, not device or quality. */
+public final class ReportReauditR33HostTest {
+ static int assertions=0;static void check(boolean x,String why){assertions++;if(!x)throw new AssertionError(why);}
+ static Map<String,Object> map(Object... pairs){Map<String,Object> m=new LinkedHashMap<>();for(int i=0;i<pairs.length;i+=2)m.put((String)pairs[i],pairs[i+1]);return m;}
+ static Map<?,?> m(Object x){return (Map<?,?>)x;}
+ static long count(Map<String,Map<?,?>> by,String id,String key){return ((Number)m(by.get(id).get("counters")).get(key)).longValue();}
+ static Map<String,Object> capture(Connection c)throws Exception{
+  Map<String,ReportSnapshotR30.Table> tables=new LinkedHashMap<>();
+  try(Statement s=c.createStatement();ResultSet r=s.executeQuery("SELECT name FROM sqlite_master WHERE type='table'")){while(r.next()){String n=r.getString(1);ReportSnapshotR30.Table t=new ReportSnapshotR30.Table(n);tables.put(n,t);}}
+  for(ReportSnapshotR30.Table t:tables.values())try(Statement s=c.createStatement();ResultSet r=s.executeQuery("PRAGMA table_info("+t.name+")")){while(r.next())t.columns.put(r.getString(2),r.getString(3));}
+  ReportSnapshotR30.Query q=new ReportSnapshotR30.Query(tables,new ArrayList<>());CapabilityRuntimeEvidenceR33.register(q);check(q.cells.size()==368,"EXACT_BOUNDED_SQL_PROJECTION_COUNT");
+  Map<String,Object> values=new LinkedHashMap<>();try(Statement s=c.createStatement();ResultSet r=s.executeQuery(q.sql())){check(r.next(),"ONE_ROW");for(int i=0;i<q.cells.size();i++)values.put(q.cells.get(i).key,r.getObject(i+1));check(!r.next(),"NO_SECOND_ROW");}
+  return CapabilityRuntimeEvidenceR33.captured(values,map("factsReadAt",1L));
+ }
+ static void nativeCounters()throws Exception{
