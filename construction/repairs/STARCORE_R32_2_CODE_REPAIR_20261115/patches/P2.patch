+    static final class HistoryRankR32 implements Comparable<HistoryRankR32> {
+        final String key;
+        final double lower;
+        final int support;
+        HistoryRankR32(String key, int devHits, int devActs, int selectHits, int selectActs) {
+            if (key == null || devActs <= 0 || selectActs <= 0 || devHits < 0 || devHits > devActs
+                    || selectHits < 0 || selectHits > selectActs)
+                throw new IllegalArgumentException("R32_HISTORY_RANK_COUNTS");
+            this.key = key;
+            this.lower = Math.min(StatsR27.wilson(devHits, devActs, StatsR27.Z95)[0],
+                                  StatsR27.wilson(selectHits, selectActs, StatsR27.Z95)[0]);
+            this.support = Math.min(devActs, selectActs);
+        }
+        @Override public int compareTo(HistoryRankR32 other) {
+            int order = Double.compare(other.lower, lower);
+            if (order == 0) order = Integer.compare(other.support, support);
+            return order == 0 ? key.compareTo(other.key) : order;
+        }
+    }
