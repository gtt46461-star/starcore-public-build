+        if (verified.hasHardConflict() || !base.equals(verified.maxIssue)
+                || verified.contiguousSuffix != MIN_LIVE_HISTORY) return java.util.Collections.emptyList();
+        return verified.contiguousSuffixAscending();
+    }
