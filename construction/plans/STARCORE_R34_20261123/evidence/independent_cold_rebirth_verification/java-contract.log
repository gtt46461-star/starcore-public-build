protectCandidateSQL=(r26_candidate.cursor=0 AND r26_candidate.checkpoint_hash='' AND r26_candidate.dev_n=0 AND r26_candidate.dev_k=0 AND r26_candidate.val_n=0 AND r26_candidate.val_k=0 AND r26_candidate.loss_sum=0 AND r26_candidate.state_hash='' AND coalesce(length(r26_candidate.state),0)=0 AND EXISTS(SELECT 1 FROM r34_cold_rebirth born WHERE born.source_kind='CANDIDATE' AND born.child_campaign=r26_candidate.campaign_id AND born.child_id=r26_candidate.policy_hash) AND NOT EXISTS(SELECT 1 FROM r34_cold_rebirth successor WHERE successor.source_kind='CANDIDATE' AND successor.source_campaign=r26_candidate.campaign_id AND successor.source_id=r26_candidate.policy_hash))
protectExpertSQL=(e.cursor=0 AND e.checkpoint_hash='' AND e.work_nanos=0 AND e.result_json='{}' AND EXISTS(SELECT 1 FROM r34_cold_rebirth born WHERE born.source_kind='EXPERT' AND born.child_campaign=e.campaign_id AND born.child_id=e.experiment_id) AND NOT EXISTS(SELECT 1 FROM r34_cold_rebirth successor WHERE successor.source_kind='EXPERT' AND successor.source_campaign=e.campaign_id AND successor.source_id=e.experiment_id))
pruneSourceSQL=DELETE FROM r26_foundry WHERE campaign_id IN (SELECT f.campaign_id FROM r26_foundry f WHERE f.status<>'RUNNING' AND NOT EXISTS(SELECT 1 FROM r26_candidate c WHERE c.campaign_id=f.campaign_id) AND NOT EXISTS(SELECT 1 FROM r26_expert_experiment e WHERE e.campaign_id=f.campaign_id AND (e.status='RUNNING' OR (e.cursor=0 AND e.checkpoint_hash='' AND e.work_nanos=0 AND e.result_json='{}' AND EXISTS(SELECT 1 FROM r34_cold_rebirth born WHERE born.source_kind='EXPERT' AND born.child_campaign=e.campaign_id AND born.child_id=e.experiment_id) AND NOT EXISTS(SELECT 1 FROM r34_cold_rebirth successor WHERE successor.source_kind='EXPERT' AND successor.source_campaign=e.campaign_id AND successor.source_id=e.experiment_id)))) AND f.campaign_id NOT IN (SELECT campaign_id FROM r26_foundry ORDER BY created_at DESC LIMIT 2) ORDER BY f.created_at,f.campaign_id LIMIT 2)
pruneExpertSQL=DELETE FROM r26_expert_experiment WHERE rowid IN (SELECT e.rowid FROM r26_expert_experiment e WHERE e.campaign_id NOT IN (SELECT campaign_id FROM r26_foundry) AND (length(e.state)=0 OR e.cursor=0 AND e.checkpoint_hash='') AND NOT (e.cursor=0 AND e.checkpoint_hash='' AND e.work_nanos=0 AND e.result_json='{}' AND EXISTS(SELECT 1 FROM r34_cold_rebirth born WHERE born.source_kind='EXPERT' AND born.child_campaign=e.campaign_id AND born.child_id=e.experiment_id) AND NOT EXISTS(SELECT 1 FROM r34_cold_rebirth successor WHERE successor.source_kind='EXPERT' AND successor.source_campaign=e.campaign_id AND successor.source_id=e.experiment_id)) LIMIT 16)
