+ private static final ScheduledThreadPoolExecutor DEADLINES=createDeadlineExecutor();
+ private static ScheduledThreadPoolExecutor createDeadlineExecutor(){ScheduledThreadPoolExecutor e=new ScheduledThreadPoolExecutor(1,new ThreadFactory(){public Thread newThread(Runnable r){Thread t=new Thread(r,"starcore-ui-funnel-deadline");t.setDaemon(true);return t;}});e.setRemoveOnCancelPolicy(true);return e;}
+ public static final long LIVE_DEADLINE_MS=250;
+ public static Snapshot capture(SQLiteDatabase db,String target,long readAt){
+  if(db==null)return unknown(target,readAt,"DB_UNAVAILABLE");
+  // An Android non-exclusive transaction is IMMEDIATE. Never extend a caller's writer reservation.
+  if(db.inTransaction())return unknown(target,readAt,"UI_FUNNEL_CALLER_TRANSACTION_BUSY");
+  final CancellationSignal signal=new CancellationSignal();
+  ScheduledFuture<?> deadline=DEADLINES.schedule(new Runnable(){public void run(){signal.cancel();}},LIVE_DEADLINE_MS,TimeUnit.MILLISECONDS);
+  try{return readStatement(db,target,readAt,null,signal);}finally{deadline.cancel(false);}
+ }
+ public static Snapshot captureSnapshotCP12(ReportReadContextCP4 report,String target){
+  if(report==null||!report.snapshotReadOnly().isReadOnly())throw new IllegalStateException("UI_FUNNEL_IMMUTABLE_SNAPSHOT_REQUIRED");
+  return readStatement(report.snapshotReadOnly(),target,report.nowMs(),report,null);
+ }
+ private static Snapshot readStatement(SQLiteDatabase db,String requested,long readAt,ReportReadContextCP4 report,CancellationSignal signal){
+  String target=TargetIssueResolver.isValid(safe(requested))?requested:"";
+  String sql=statementCP12();ArrayList<Row> values=new ArrayList<Row>(14);long online=-1;
+  try(Cursor c=report==null?db.rawQuery(sql,new String[]{target},signal):report.select(sql,new String[]{target})){
+   while(c.moveToNext()){
+    if(report!=null)report.checkpoint();else if(signal.isCanceled())throw new IllegalStateException("UI_FUNNEL_TIME_BUDGET_EXCEEDED");
+    int ordinal=c.getInt(0);target=safe(c.getString(6));
+    if(ordinal==14){online=c.isNull(1)?-1:c.getLong(1);continue;}
+    Definition d=DEFINITIONS[ordinal];Long count=c.isNull(1)?null:Long.valueOf(c.getLong(1));String reason=safe(c.getString(4)),ref=safe(c.getString(5));
+    if(ordinal==13&&!safe(c.getString(3)).isEmpty())reason=realReasonCP12(c.getString(7),c.getString(8),reason,c.getString(3));
+    if(count==null)reason="TARGET_UNOBSERVED";else if(reason.isEmpty()&&count.longValue()==0)reason="UNOBSERVED";
+    if(ref.isEmpty())ref=queryRef(d);
+    values.add(new Row(d,count,c.getString(2),c.getString(3),reason,ref,count==null?"UNKNOWN":"READ_OK"));
+   }
+   if(values.size()!=14)throw new IllegalStateException("UI_FUNNEL_INCOMPLETE_RESULT");
+   return new Snapshot(target,readAt,values,online);
+  }catch(RuntimeException failure){
+   if(report!=null){report.checkpoint();if(failure instanceof ReportReadContextCP4.ReportReadFailureCP4&&((ReportReadContextCP4.ReportReadFailureCP4)failure).code.equals("REPORT_CONTEXT_CANCELLED"))throw failure;}
+   return unknown(target,readAt,signal!=null&&signal.isCanceled()?"UI_FUNNEL_TIME_BUDGET_EXCEEDED":"READ_QUERY_FAILED");
+  }
+ }
+ /** One read-only SQLite statement owns the 14 counts, oldest blockers, formal/online split and target watermark. */
+ static String statementCP12(){
+  StringBuilder b=new StringBuilder("WITH target_scope(target) AS (SELECT CASE WHEN ?<>'' THEN ?ELSE COALESCE((SELECT target_issue FROM v57_shadow_observation_r35 WHERE pre_draw_frozen=1 ORDER BY commit_at DESC,target_issue DESC LIMIT 1),(SELECT target_issue FROM v57_settlement_task_r36 WHERE status IN('COMPLETED','NO_PREDRAW_CANONICAL_TERMINAL','FAILED_TERMINAL','INVALID_DRAW_TERMINAL') ORDER BY target_issue DESC LIMIT 1),(SELECT issue FROM draws WHERE dirty=0 ORDER BY issue DESC LIMIT 1),'') END) ");
+  // Only one argument is bound; the first placeholder is a local scalar CTE, reused without extra binds.
+  String prefix=b.toString().replace("CASE WHEN ?<>'' THEN ?ELSE", "CASE WHEN supplied<>'' THEN supplied ELSE");
+  b=new StringBuilder("WITH supplied_target(supplied) AS (SELECT ?),target_scope(target) AS (SELECT ").append(prefix.substring(prefix.indexOf("CASE WHEN"),prefix.lastIndexOf(')'))).append(" FROM supplied_target) ");
+  for(int i=0;i<DEFINITIONS.length;i++){
+   if(i>0)b.append(" UNION ALL ");Definition d=DEFINITIONS[i];String success=d.success.replace("?","(SELECT target FROM target_scope)");
+   b.append("SELECT ").append(i).append(" ordinal,").append(i==11?"CASE WHEN length(t.target)=12 THEN a.n ELSE NULL END":"a.n").append(" n,substr(a.last_issue,1,20) last_issue,substr(COALESCE(z.issue,''),1,20) blocked_issue,substr(COALESCE(z.reason,''),1,512) reason,CASE WHEN length(COALESCE(z.ref,''))<=192 THEN COALESCE(z.ref,'') ELSE '").append(queryRef(d)).append("' END ref,t.target,").append(i==13?"substr(COALESCE(z.reason_json,''),1,8192),COALESCE(z.reason_hash,'')":"'',''").append(" FROM (SELECT COUNT(*) n,COALESCE(MAX(issue),'') last_issue FROM (").append(success).append(")) a CROSS JOIN target_scope t LEFT JOIN (SELECT ").append(i==13?"issue,reason,ref,reason_json,reason_hash":"issue,reason,ref").append(" FROM (").append(d.block).append(") ORDER BY issue,ref LIMIT 1) z ON 1=1");
+  }
+  b.append(" UNION ALL SELECT 14,COUNT(*),'','','','',(SELECT target FROM target_scope),'','' FROM r952_candidate_predraw WHERE settled=1 AND evidence_role IN('ONLINE_TRAINING','TRAIN_STREAM_V2') AND proof_error='' ORDER BY ordinal");
+  return b.toString();
+ }
+ private static String realReasonCP12(String json,String hash,String raw,String target){
+  String text=CanonicalReasonCP12.existingReceiptText(safe(json),safe(hash),safe(raw));
+  String code=CanonicalReasonCP12.persistedCode(text).name();
+  if(json!=null&&!json.isEmpty())try{org.json.JSONObject value=new org.json.JSONObject(json);if(!safe(target).equals(value.optString("target_issue"))||!safe(raw).equals(value.optString("detail_code")))code="INTEGRITY_FAILED";}catch(Exception invalid){code="INTEGRITY_FAILED";}
+  String display=code+"|detail="+safe(raw);return display.substring(0,Math.min(512,display.length()));
+ }
+ private static Snapshot unknown(String target,long at,String reason){ArrayList<Row> rows=new ArrayList<Row>(14);for(Definition d:DEFINITIONS)rows.add(new Row(d,null,"","",reason,queryRef(d),"UNKNOWN"));return new Snapshot(TargetIssueResolver.isValid(safe(target))?target:"",at,rows,-1);}
+ private static String queryRef(Definition d){return "QUERY:"+V51ChecksumEngine.sha256(d.success+"|"+d.block);}
+ private static String safe(String value){return value==null?"":value;}
+ private static String field(String value){String s=safe(value);return s.length()+":"+s;}
+}
