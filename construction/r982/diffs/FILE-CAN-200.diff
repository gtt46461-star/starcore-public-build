+public static int intScalarSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, SQLiteDatabase db, String sql, String[] args) {
+        Cursor c = null;
+        try {
+            c = report.select(sql, args);
+            return c.moveToFirst() ? c.getInt(0) : 0;
+        } finally {
+            if (c != null) c.close();
+        }
+    }
