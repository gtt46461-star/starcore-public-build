+public static String performanceRawSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s, int limit) {
+        if (s == null) return "STORE_NULL\n";
+        int capped = Math.max(1, Math.min(120, limit));
+        return querySnapshotCP4(report, 
+                s,
+                "SELECT target_issue AS issue,process_id,release_code,request_at,runtime_at,durable_at,queue_ms,compute_ms,commit_ms,total_ms,sample_class FROM v57_prediction_timing_r925 WHERE release_code="
+                        + BuildConfig.VERSION_CODE
+                        + " ORDER BY durable_at DESC LIMIT "
+                        + capped,
+                false);
+    }
