+public static void appendLatencySnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, 
+            com.ethk3.novaonepro.ReportTextCP12 b, String name, ArrayList<Long> samples, long budget, boolean hasBudget) {
+        Batch2ContractCoreR926.LatencyStats x =
+                Batch2ContractCoreR926.latencyStats(samples, budget);
+        b.append(name)
+                .append(" P50=")
+                .append(x.n == 0 ? "N/A" : x.p50 + "ms")
+                .append(" P95=")
+                .append(x.n == 0 ? "N/A" : x.p95 + "ms")
+                .append(" P99=")
+                .append(x.n == 0 ? "N/A" : x.p99 + "ms")
+                .append(" max=")
+                .append(x.n == 0 ? "N/A" : x.max + "ms")
+                .append(" budget=")
+                .append(hasBudget ? budget + "ms" : "N/A")
+                .append(" overBudget=")
+                .append(hasBudget ? String.valueOf(x.overBudget) : "N/A")
+                .append('\n');
+    }
