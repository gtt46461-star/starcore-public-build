+public static String epochsSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s) {
+        SQLiteDatabase db = s.readable();
+        com.ethk3.novaonepro.ReportTextCP12 b = new com.ethk3.novaonepro.ReportTextCP12(report, "RELEASE_PROCESS_COVERAGE\n");
+        for (String id :
+                new String[] {
+                    "release-" + BuildConfig.VERSION_CODE,
+                    PROCESS_ID,
+                    "cadence-Binance-60000-release-" + BuildConfig.VERSION_CODE
+                }) {
+            Cursor c =
+                    report.select(
+                            "SELECT start_issue,started_at FROM v57_runtime_epoch_r925 WHERE epoch_id=?",
+                            new String[] {id});
+            try {
+                if (!c.moveToFirst()) {
+                    b.append(id).append(" N/A\n");
+                    continue;
+                }
+                String start = c.getString(0);
+                long at = c.getLong(1);
+                String filter = " WHERE dirty=0 AND issue>? AND open_time>=?";
+                String[] args = {start, String.valueOf(at)};
+                String total = scalarSnapshotCP4(report, db, "SELECT COUNT(*) FROM draws" + filter, args);
+                String pred =
+                        scalarSnapshotCP4(report, 
+                                db,
+                                "SELECT COUNT(*) FROM (SELECT issue FROM draws"
+                                        + filter
+                                        + ") d JOIN "
+                                        + DbHelper.TABLE_R35_SHADOW_OBSERVATION
+                                        + " o ON o.target_issue=d.issue AND o.pre_draw_frozen=1",
+                                args);
+                b.append(id)
+                        .append(" | 起始=")
+                        .append(start)
+                        .append(" | 预测/开奖=")
+                        .append(pred)
+                        .append('/')
+                        .append(total)
+                        .append(" | 覆盖=")
+                        .append(pctSnapshotCP4(report, Long.parseLong(pred), Long.parseLong(total)))
+                        .append('\n');
+            } finally {
+                c.close();
+            }
+        }
+        return b.append("仅统计纪元开始后实际开奖；旧缺口另列；不足120期为观察中。\n").toString();
+    }
+
+public static String scalarSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, SQLiteDatabase db, String sql, String[] args) {
+        Cursor c = report.select(sql, args);
+        try {
+            return c.moveToFirst() ? c.getString(0) : "0";
+        } finally {
+            c.close();
+        }
+    }
