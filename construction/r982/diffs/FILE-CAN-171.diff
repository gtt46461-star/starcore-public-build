+public static String pipelineSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s, int limit, boolean csv) {
+        if (s == null) return "R926_EVENT_PROJECTION_STORE_NULL\n";
+        SQLiteDatabase db = s.readable();
+        int capped = Math.max(1, Math.min(500, limit));
+        return csv
+                ? RuntimeEventLedgerR926.exportCsvSnapshotCP4(report, db, capped)
+                : RuntimeEventLedgerR926.exportTextSnapshotCP4(report, db, capped);
+    }
