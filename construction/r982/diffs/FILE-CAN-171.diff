+public static String querySnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s, String sql, boolean csv) {
+        com.ethk3.novaonepro.ReportTextCP12 b = new com.ethk3.novaonepro.ReportTextCP12(report);
+        Cursor c = report.select(sql, null);
+        try {
+            for (int i = 0; i < c.getColumnCount(); i++) {
+                if (i > 0) b.append(csv ? ',' : '|');
+                b.append(escapeSnapshotCP4(report, c.getColumnName(i), csv));
+            }
+            b.append('\n');
+            while (c.moveToNext()) {
+                for (int i = 0; i < c.getColumnCount(); i++) {
+                    if (i > 0) b.append(csv ? ',' : '|');
+                    b.append(escapeSnapshotCP4(report, c.isNull(i) ? "N/A" : c.getString(i), csv));
+                }
+                b.append('\n');
+            }
+        } finally {
+            c.close();
+        }
+        return b.toString();
+    }
+
+public static String escapeSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, String v, boolean csv) {
+        return csv
+                ? '"' + v.replace("\"", "\"\"") + '"'
+                : v.replace('\n', ' ').replace('|', '/');
+    }
