+public static String performanceSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s) {
+        if (s == null) return "PERFORMANCE_STORE_NULL\n";
+        com.ethk3.novaonepro.ReportTextCP12 b = new com.ethk3.novaonepro.ReportTextCP12(report, "PERFORMANCE_B05_COLD_VS_WARM\n");
+        b.append("budgets: requestToDurable=")
+                .append(Batch2ContractCoreR926.REQUEST_TO_DURABLE_BUDGET_MS)
+                .append("ms compute=")
+                .append(Batch2ContractCoreR926.COMPUTE_BUDGET_MS)
+                .append("ms commitSlice=")
+                .append(Batch2ContractCoreR926.DB_SLICE_TARGET_MS)
+                .append("ms coldTarget=")
+                .append(Batch2ContractCoreR926.COLD_START_TARGET_MS)
+                .append("ms\n");
+        for (String type : new String[] {"COLD_MONOTONIC", "WARM_MONOTONIC"}) {
+            ArrayList<Long> queue = new ArrayList<Long>();
+            ArrayList<Long> compute = new ArrayList<Long>();
+            ArrayList<Long> commit = new ArrayList<Long>();
+            ArrayList<Long> total = new ArrayList<Long>();
+            Cursor c =
+                    report.select(
+                                    "SELECT queue_ms,compute_ms,commit_ms,total_ms FROM v57_prediction_timing_r925 WHERE release_code=? AND sample_class=? ORDER BY durable_at DESC LIMIT 120",
+                                    new String[] {String.valueOf(BuildConfig.VERSION_CODE), type});
+            try {
+                while (c.moveToNext()) {
+                    queue.add(Long.valueOf(Math.max(0L, c.getLong(0))));
+                    compute.add(Long.valueOf(Math.max(0L, c.getLong(1))));
+                    commit.add(Long.valueOf(Math.max(0L, c.getLong(2))));
+                    total.add(Long.valueOf(Math.max(0L, c.getLong(3))));
+                }
+            } finally {
+                c.close();
+            }
+            b.append(type).append(" N=").append(total.size()).append('\n');
+            appendLatencySnapshotCP4(report, b, "queue", queue, Long.MAX_VALUE, false);
+            appendLatencySnapshotCP4(report, 
+                    b,
+                    "compute",
+                    compute,
+                    Batch2ContractCoreR926.COMPUTE_BUDGET_MS,
+                    true);
+            appendLatencySnapshotCP4(report, 
+                    b,
+                    "commit",
+                    commit,
+                    Batch2ContractCoreR926.DB_SLICE_TARGET_MS,
+                    true);
+            long totalBudget =
+                    "COLD_MONOTONIC".equals(type)
+                            ? Batch2ContractCoreR926.COLD_START_TARGET_MS
+                            : Batch2ContractCoreR926.REQUEST_TO_DURABLE_BUDGET_MS;
+            appendLatencySnapshotCP4(report, b, "requestToDurable", total, totalBudget, true);
+            if ("WARM_MONOTONIC".equals(type)) {
+                Batch2ContractCoreR926.LatencyStats stats =
+                        Batch2ContractCoreR926.latencyStats(
+                                total, Batch2ContractCoreR926.REQUEST_TO_DURABLE_BUDGET_MS);
+                b.append("B05_WARM_ACCEPTANCE=")
+                        .append(
+                                !"COMPLETE_120".equals(RuntimeAttemptObservabilityR926.acceptanceWindowSnapshotCP4(report, s)) || stats.n < 120
+                                        ? "INCOMPLETE_OR_FAILED_ATTEMPT_WINDOW"
+                                        : stats.p95
+                                                        <= Batch2ContractCoreR926
+                                                                .REQUEST_TO_DURABLE_BUDGET_MS
+                                                && Batch2ContractCoreR926.latencyStats(compute, Batch2ContractCoreR926.COMPUTE_BUDGET_MS).p95 <= Batch2ContractCoreR926.COMPUTE_BUDGET_MS
+                                                ? "PASS_P95_WITHIN_BUDGET"
+                                                : "FAIL_P95_OVER_BUDGET")
+                        .append('\n');
+            }
+        }
+        b.append(RuntimeAttemptObservabilityR926.reportSnapshotCP4(report, s));
+        b.append("RAW_LAST_120\n").append(performanceRawSnapshotCP4(report, s, 120));
+        b.append(RuntimeResourceAuditR927.reportSnapshotCP4(report, s));
+        return b.toString();
+    }
