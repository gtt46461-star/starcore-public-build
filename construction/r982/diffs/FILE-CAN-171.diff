+        for (int size : new int[] {0, 30, 60, 120}) {
+            String recent =
+                    size == 0
+                            ? ""
+                            : " AND o.target_issue IN (SELECT issue FROM draws WHERE dirty=0 ORDER BY issue DESC LIMIT "
+                                    + size
+                                    + ")";
+            Cursor c =
+                    report.select(
+                            "SELECT COUNT(*),COALESCE(SUM(CASE WHEN l.hit_label IN(0,1) THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN l.hit_label=1 THEN 1 ELSE 0 END),0) FROM "
+                                    + DbHelper.TABLE_R35_SHADOW_OBSERVATION
+                                    + " o LEFT JOIN "
+                                    + DbHelper.TABLE_R35_OOS_LABEL
+                                    + " l ON l.target_issue=o.target_issue AND l.strict_oos=1 WHERE o.pre_draw_frozen=1"
+                                    + recent,
+                            null);
+            try {
+                c.moveToFirst();
+                int total = c.getInt(0), n = c.getInt(1), hit = c.getInt(2);
+                AlgorithmEvidencePolicyR912.Decision w =
+                        AlgorithmEvidencePolicyR912.evaluate(n, hit, 0, 0);
+                b.append(size == 0 ? "全部" : "最近" + size + "期开奖")
+                        .append("：总数 ")
+                        .append(total)
+                        .append("｜已结算 ")
+                        .append(n)
+                        .append("｜待结算 ")
+                        .append(total - n)
+                        .append("｜中/未中 ")
+                        .append(hit)
+                        .append('/')
+                        .append(n - hit)
+                        .append("｜命中 ")
+                        .append(pctSnapshotCP4(report, hit, n))
+                        .append("｜Wilson ")
