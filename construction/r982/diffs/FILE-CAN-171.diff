+public static String fetchesSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportReadContextCP4 s, int limit) {
+        return FetchLedgerR925.reportSnapshotCP4(report, s, limit)
