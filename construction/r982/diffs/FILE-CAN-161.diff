+        check(!shape.primaryKeyColumns.isEmpty(),"ARCHIVE_NO_PK");return key.value();
+    }
+    /** Snapshot-local key is never treated as a permanent business identity. */
+    public static byte[] snapshotLocalKey(TableShape shape,long rowid) {
