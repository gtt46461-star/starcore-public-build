+    public static final class Normalizer {
+        private final double[] mean,std;
+        public final String hash;
+        Normalizer(CandidateCompilerR952.Modern model,FeatureManifestR952 manifest){
+            model.requireManifest(manifest);mean=model.means();std=model.standardDeviations();hash=model.normalizerHash;
+        }
+        public double mean(int i){return mean[i];}
+        public double std(int i){return std[i];}
+        public int size(){return mean.length;}
+    }
+    public static final class ExpertPrediction {
+        public final String freezeHash,modelHash,featureManifestHash,target,maxSourceIssue,sourceHash;
+        public final int position;
+        public final long availableAtMs;
+        private final double[] probabilities;
+        public ExpertPrediction(CandidateCompilerR952.ExpertRef ref,String target,String maxSourceIssue,
+                long availableAtMs,String sourceHash,double[] probabilities){
+            need(ref!=null&&probabilities!=null&&probabilities.length==10,"EXPERT_DIMENSION");
+            need(TargetIssueResolver.isValid(target)&&TargetIssueResolver.isValid(maxSourceIssue)
+                &&maxSourceIssue.compareTo(target)<0&&availableAtMs>=0,"EXPERT_PIT");
+            this.freezeHash=ref.freezeHash;this.modelHash=ref.modelHash;this.featureManifestHash=ref.featureManifestHash;
+            this.position=ref.position;this.target=target;this.maxSourceIssue=maxSourceIssue;
+            this.availableAtMs=availableAtMs;this.sourceHash=hash(sourceHash);this.probabilities=probabilities.clone();
+            double sum=0;for(double x:this.probabilities){need(Double.isFinite(x)&&x>=0&&x<=1,"EXPERT_PROBABILITY");sum+=x;}
+            need(Math.abs(sum-1)<=1e-9,"EXPERT_PROBABILITY_SUM");
+        }
+        public double[] probabilities(){return probabilities.clone();}
+        public boolean matchesFrozenRef(CandidateCompilerR952.ExpertRef ref){
+            return ref!=null&&freezeHash.equals(ref.freezeHash)&&modelHash.equals(ref.modelHash)
+                &&featureManifestHash.equals(ref.featureManifestHash)&&position==ref.position;
+        }
+    }
+
+    private FrozenGraphContextCP4(CandidateCompilerR952.Program program,CandidateCompilerR952.Model model,
+            PITSnapshotContractR952 pit,String freeze,long at,Map<String,TypedAtomMoleculeGraphR930.Value> atoms,
+            List<ExpertPrediction> experts,Map<String,String> bindingHashes,MemoryBudgetCP4 budget,
+            Map<String,MatrixBindingsCP12.Frozen> matrices){
+        need(program!=null&&program.ast.formatVersion==3&&model!=null&&!model.isLegacy()&&pit!=null,"AST3_CONTEXT_REQUIRED");
+        need(at>0&&atoms!=null&&experts!=null&&bindingHashes!=null,"CONTEXT_INPUT");
+        model.modern().requireManifest(program.manifest);
+        need(model.modern().kind==program.ast.graphSpec.modelKind&&model.modern().family==program.ast.family,"MODEL_AST_MISMATCH");
+        need(model.modern().trainedUntil.compareTo(pit.targetIssue)<0,"MODEL_TRAINED_AFTER_TARGET");
+        pit.requireConsecutive();need(pit.history.size()>=program.manifest.requiredHistory,"INSUFFICIENT_HISTORY");
+        target=pit.targetIssue;pitHash=pit.snapshotHash;freezeHash=hash(freeze);modelHash=model.hash();frozenAt=at;
+        manifest=program.manifest;normalizer=new Normalizer(model.modern(),manifest);
+        registeredSpecs=Collections.unmodifiableList(new ArrayList<>(program.specs));
+        TreeMap<String,TypedAtomMoleculeGraphR930.Value> copy=new TreeMap<>();
+        for(TypedAtomMoleculeGraphR930.NodeSpec node:program.ast.graphSpec.nodes){
+            if(node.kind!=TypedAtomMoleculeGraphR930.NodeKind.ATOM)continue;
+            TypedAtomMoleculeGraphR930.Value v=atoms.get(node.qualifiedId());
+            need(v!=null&&v.size()==node.shape.elements(),"FROZEN_ATOM_CLOSURE");
+            need(TargetIssueResolver.isValid(v.maxSourceIssue)&&v.maxSourceIssue.compareTo(target)<0
+                &&v.availableAtMs<=at,"FROZEN_ATOM_PIT");
+            for(int j=0;j<v.size();j++)need(Double.isFinite(v.get(j))&&(v.present(j)||v.get(j)==0),"FROZEN_ATOM_ENCODING");
+            copy.put(node.qualifiedId(),v);
+        }
+        need(copy.keySet().equals(atoms.keySet()),"FROZEN_ATOM_CLOSURE");
+        replayFrozenAtoms=Collections.unmodifiableMap(copy);
+        need(matrices!=null,"MATRIX_CAPTURE_REQUIRED");
+        MatrixBindingsCP12.validateFrozen(program,target,pit.lastIssue,at,matrices,copy);
+        frozenMatrices=Collections.unmodifiableMap(new TreeMap<>(matrices));
+        TreeMap<String,String> bindings=new TreeMap<>();for(Map.Entry<String,String> e:bindingHashes.entrySet())bindings.put(hash(e.getKey()),hash(e.getValue()));
+        need(new ArrayList<>(bindings.keySet()).equals(manifest.bindingHashes),"FROZEN_BINDING_CLOSURE");
+        bindingPayloadHashes=Collections.unmodifiableMap(bindings);
+        need(experts.size()==program.ast.graphSpec.experts.size()&&experts.size()==model.modern().experts.size(),"EXPERT_CLOSURE");
+        ArrayList<ExpertPrediction> ecopy=new ArrayList<>();
+        for(int i=0;i<experts.size();i++){
+            ExpertPrediction e=experts.get(i);need(e!=null&&e.matchesFrozenRef(program.ast.graphSpec.experts.get(i))
+                &&e.matchesFrozenRef(model.modern().experts.get(i))&&e.target.equals(target)&&e.availableAtMs<=at,"EXPERT_IDENTITY");
+            ecopy.add(e);
+        }
+        this.experts=Collections.unmodifiableList(ecopy);atomMatrixBudget=Objects.requireNonNull(budget);
+        // Reserve retained context (including both UTF-16 JSON and parsed object overhead) before encoding.
+        long bytes=8192L+registeredSpecs.size()*16384L+copy.size()*2048L+ecopy.size()*2048L+bindings.size()*512L+frozenMatrices.size()*4096L;
+        MemoryBudgetCP4.Lease reserved=budget.acquire(bytes);
+        try{canonical=StrictCanonicalJson.writeContext(canonicalObject(program));contextHash=V51ChecksumEngine.sha256(canonical);lease=reserved;}
+        catch(RuntimeException|Error e){reserved.close();throw e;}
+    }
+    private FrozenGraphContextCP4(PITSnapshotContractR952 pit){
+        need(pit!=null,"MISSING_PIT");target=pit.targetIssue;pitHash=pit.snapshotHash;freezeHash=modelHash=contextHash=canonical="";
+        frozenAt=0;manifest=null;normalizer=null;registeredSpecs=Collections.emptyList();experts=Collections.emptyList();
+        replayFrozenAtoms=Collections.emptyMap();bindingPayloadHashes=Collections.emptyMap();frozenMatrices=Collections.emptyMap();atomMatrixBudget=null;lease=null;
+    }
+    public static FrozenGraphContextCP4 legacy(PITSnapshotContractR952 pit){return new FrozenGraphContextCP4(pit);}
