+/** Immutable capture/replay boundary. No database, clock, inference or publication authority. */
+public final class FrozenGraphContextCP4 implements AutoCloseable {
+    public static final String REVISION="SCCONTEXT1", MATRIX_REVISION="SCCONTEXT2";
+    public final String target,pitHash,freezeHash,modelHash,contextHash;
+    public final long frozenAt;
+    public final FeatureManifestR952 manifest;
+    public final List<AtomSpecCP4> registeredSpecs;
+    public final Normalizer normalizer;
+    public final List<ExpertPrediction> experts;
+    public final Map<String,TypedAtomMoleculeGraphR930.Value> replayFrozenAtoms;
