+            SQLiteDatabase db = store.readable();
+            c =
+                    report.select(
+                            "SELECT target_issue,settled,hit_label,created_at FROM "
+                                    + DbHelper.TABLE_R35_SHADOW_OBSERVATION
+                                    + " ORDER BY created_at DESC LIMIT 10",
+                            null);
+            int row = 0;
+            while (c.moveToNext()) {
+                row++;
+                String target = c.getString(0);
+                QueryInt oos =
+                        countDbSnapshotCP4(report, 
+                                db,
+                                "SELECT COUNT(1) FROM "
+                                        + DbHelper.TABLE_R35_OOS_LABEL
+                                        + " WHERE target_issue=? AND strict_oos=1",
+                                new String[] {target});
+                QueryInt full =
+                        countDbSnapshotCP4(report, 
+                                db,
+                                "SELECT COUNT(1) FROM "
+                                        + V51Repository.ACTION_SPACE
+                                        + " WHERE target_issue=?",
+                                new String[] {target});
+                String deferred =
+                        textScalarSnapshotCP4(report, 
+                                db,
+                                "SELECT status FROM "
+                                        + DbHelper.TABLE_R35_DEFERRED_EVIDENCE_JOB
+                                        + " WHERE target_issue=?",
+                                new String[] {target});
+                String task =
+                        textScalarSnapshotCP4(report, 
+                                db,
+                                "SELECT status FROM "
+                                        + DbHelper.TABLE_R36_SETTLEMENT_TASK
+                                        + " WHERE target_issue=?",
+                                new String[] {target});
+                b.append(row)
+                        .append("|target=")
+                        .append(target)
+                        .append("|canonical=1|settled=")
+                        .append(c.getInt(1))
+                        .append("|hitLabel=")
+                        .append(c.getInt(2))
+                        .append("|strictOos=")
+                        .append(oos.render())
+                        .append("|formalActions=")
+                        .append(full.render())
+                        .append("|deferred=")
