+   Page page=preparePage(db,store.openResearchAssetCP12(ASSET),cursor,deadlineNs);
+   Long next=store.coordinatorForResearchR952().runAtomicWrite("CP12_MOLECULE_IMPORT",tx->MolecularToolWorldR947.importSeedBatchCP4(tx,page.rows,page.cursor),null);
+   if(next==null)throw new IllegalStateException("SEED_IMPORT_COMMIT_FAILED");return "SEEDS_IMPORTED:"+next+"/"+TOTAL;
+  }catch(IOException e){throw new DevelopmentProductionCP12.Wait("WAIT_INPUT_IO",e);}}
+  return ModernFamilyFactoryCP12.maintain(store,deadlineNs);
+  }catch(IllegalStateException resource){if("ALGORITHM_MEMORY_BUDGET".equals(resource.getMessage()))throw new DevelopmentProductionCP12.Wait("MEMORY_PRESSURE",resource);throw resource;}
+ }
