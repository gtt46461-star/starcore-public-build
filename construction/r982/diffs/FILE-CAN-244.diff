+ /** Streams the complete immutable 3.3MB asset for checksum, retaining at most 25 bounded rows. */
+ public static Page preparePage(SQLiteDatabase db,InputStream input,long cursor,long deadlineNs)throws IOException{
+  need(db!=null&&!db.inTransaction()&&input!=null&&cursor>=0&&cursor<=TOTAL,"SEED_PREPARE_INPUT");
+  MessageDigest digest;try{digest=MessageDigest.getInstance("SHA-256");}catch(NoSuchAlgorithmException e){throw new AssertionError(e);}
+  List<String> lines=new ArrayList<>();int count=0,bytes=0;ByteArrayOutputStream line=new ByteArrayOutputStream(4096);byte[] buffer=new byte[8192];int n;
+  try(InputStream in=input){while((n=in.read(buffer))!=-1){ResearchWorkBudgetR927.checkpoint();if(System.nanoTime()>=deadlineNs)throw new DevelopmentProductionCP12.Wait("TIME_BUDGET_EXCEEDED");bytes+=n;need(bytes<=4<<20,"SEED_ASSET_SIZE");digest.update(buffer,0,n);
+   for(int i=0;i<n;i++){if(buffer[i]=='\n'){if(count>=cursor&&count<cursor+BATCH)lines.add(new String(line.toByteArray(),StandardCharsets.UTF_8));count++;line.reset();}else{line.write(buffer[i]);need(line.size()<=8192,"SEED_LINE_SIZE");}}
+  }}
+  need(line.size()==0&&count==TOTAL&&hex(digest.digest()).equals(ASSET_SHA),"SEED_ASSET_IDENTITY");
+  List<SeedRow> rows=new ArrayList<>();for(int i=0;i<lines.size();i++)rows.add(new SeedRow(lines.get(i),(int)cursor+i,db));return new Page(cursor,rows);
+ }
