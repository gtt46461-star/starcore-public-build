+ public static String currentDomainReason(DbStore store,String lifetime,String target){
+  try {
+   int mask=0,position=0;
+   try(Cursor c=store.readable().rawQuery("SELECT d.observed FROM research_certificate_r929 c JOIN research_certificate_gate_r932 g ON g.certificate_hash=c.certificate_hash AND g.gate_id='CP4_LIFETIME' JOIN research_certificate_gate_r932 d ON d.certificate_hash=c.certificate_hash AND d.gate_id='DOMAIN_SUPPORT' WHERE g.source_hash=? AND g.pass=1 AND d.pass=1 AND c.state='ACTIVE'",new String[]{lifetime})){if(!c.moveToFirst())return "CP4_CERT_DOMAIN_MISSING";mask=c.getInt(0);if(c.moveToNext())return "CP4_CERT_DOMAIN_AMBIGUOUS";}
+   try(Cursor c=store.readable().rawQuery("SELECT DISTINCT p.position FROM "+ResearchGatePlanR967.CP4_BINDING+" b JOIN "+FixedResearchWindowR932.PAIR+" p ON p.window_id=b.window_id WHERE b.lifetime_id=? AND p.target_issue<? LIMIT 2",new String[]{lifetime,target})){if(!c.moveToFirst())return "CP4_FIXED_POSITION_MISSING";position=c.getInt(0);if(c.moveToNext())return "CP4_FIXED_POSITION_CHANGED";}
+   Context ctx=context(store.readable(),position,target);if(ctx.js>.1)return "DRIFT_LIMIT";return (mask&(1<<ctx.regime))==0?"NO_SUPPORTED_REGIME":"";
