+                    .append("\nEvidence=")
+                    .append(c.evidence)
+                    .append("\nAction=")
+                    .append(c.action)
+                    .append("\nHash=")
+                    .append(c.checksum)
+                    .append('\n');
+        }
+        b.append("ReportHash=").append(r.checksum).append('\n');
+        return b.toString();
+    }
