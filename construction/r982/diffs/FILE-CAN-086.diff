+public static String joinIntsSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, int[] values) {
+        com.ethk3.novaonepro.ReportTextCP12 out = new com.ethk3.novaonepro.ReportTextCP12(report);
