+package com.ethk3.novaonepro;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+/** Permanent small identity decouples the receipt FK from mutable/full model raw-tail payloads. */
+public final class RetentionArtifactIdentityCP12 {
+ private RetentionArtifactIdentityCP12(){}
+ public static void install(SQLiteDatabase db){
+  if(db==null||!db.inTransaction())throw new IllegalStateException("ARTIFACT_ANCHOR_SCHEMA_TRANSACTION");
+  db.execSQL(ANCHOR_DDL);boolean already=false;
+  try(Cursor c=db.rawQuery("PRAGMA foreign_key_list(research_development_receipt_v2)",null)){while(c.moveToNext())if("research_artifact_identity_v2".equals(c.getString(2)))already=true;}
+  if(!already){
+   db.execSQL(COPY_EXISTING);
+   try(Cursor c=db.rawQuery("SELECT 1 FROM research_development_receipt_v2 d JOIN r952_artifact a ON a.artifact_hash=d.artifact_hash LEFT JOIN research_artifact_identity_v2 i ON i.artifact_hash=a.artifact_hash WHERE i.artifact_hash IS NULL OR i.candidate_id<>a.candidate_id OR i.target_issue<>a.target_issue OR i.delivery_hash<>a.delivery_hash OR i.payload_hash<>a.payload_hash OR i.development_receipt_hash<>a.development_receipt_hash OR i.validation_hash<>a.validation_hash OR i.training_kind<>a.training_kind OR i.development_sample_n<>a.development_sample_n OR i.validation_sample_n<>a.validation_sample_n OR i.validation_pass<>a.validation_pass LIMIT 1",null)){if(c.moveToFirst())throw new IllegalStateException("ARTIFACT_ANCHOR_MIGRATION_CONFLICT");}
+   for(String sql:REBUILD)db.execSQL(sql);
+  }
+  db.execSQL("DROP TRIGGER IF EXISTS cp8_development_receipt_identity");
+  for(String sql:GUARDS)db.execSQL(sql);
+  try(Cursor c=db.rawQuery("PRAGMA foreign_key_check(research_development_receipt_v2)",null)){if(c.moveToFirst())throw new IllegalStateException("ARTIFACT_ANCHOR_FOREIGN_KEY_CHECK");}
+ }
+ /** ResearchDirectorR952.commitCandidateBatchCP11 only; must precede the immutable developmentreceipt INSERT. */
+ public static void register(SQLiteDatabase db,String artifact){
+  if(db==null||!db.inTransaction()||artifact==null||!artifact.matches("[0-9a-f]{64}"))throw new IllegalStateException("ARTIFACT_ANCHOR_TRANSACTION");
+  try(Cursor c=db.rawQuery("SELECT 1 FROM research_artifact_identity_v2 i JOIN r952_artifact a ON a.artifact_hash=i.artifact_hash WHERE i.artifact_hash=? AND i.candidate_id=a.candidate_id AND i.target_issue=a.target_issue AND i.delivery_hash=a.delivery_hash AND i.payload_hash=a.payload_hash AND i.development_receipt_hash=a.development_receipt_hash AND i.validation_hash=a.validation_hash AND i.training_kind=a.training_kind AND i.development_sample_n=a.development_sample_n AND i.validation_sample_n=a.validation_sample_n AND i.validation_pass=a.validation_pass",new String[]{artifact})){if(c.moveToFirst())return;}
+  db.execSQL(REGISTER,new Object[]{artifact});
+  try(Cursor c=db.rawQuery("SELECT changes()",null)){if(!c.moveToFirst()||c.getInt(0)!=1)throw new IllegalStateException("ARTIFACT_ANCHOR_SOURCE_MISSING");}
+ }
+ private static final String ANCHOR_DDL="CREATE TABLE IF NOT EXISTS research_artifact_identity_v2(\n artifact_hash TEXT PRIMARY KEY CHECK(length(artifact_hash)=64),\n candidate_id TEXT NOT NULL,target_issue TEXT NOT NULL,delivery_hash TEXT NOT NULL UNIQUE,\n payload_hash TEXT NOT NULL CHECK(length(payload_hash)=64),\n development_receipt_hash TEXT NOT NULL CHECK(length(development_receipt_hash)=64),\n validation_hash TEXT NOT NULL CHECK(length(validation_hash)=64),\n training_kind TEXT NOT NULL CHECK(training_kind='DEVELOPMENT_AST3'),\n development_sample_n INTEGER NOT NULL CHECK(development_sample_n BETWEEN 300 AND 1200),\n validation_sample_n INTEGER NOT NULL CHECK(validation_sample_n=120),\n validation_pass INTEGER NOT NULL CHECK(validation_pass=1),created_at INTEGER NOT NULL)";
+ private static final String COPY_EXISTING="INSERT INTO research_artifact_identity_v2(artifact_hash,candidate_id,target_issue,delivery_hash,payload_hash,development_receipt_hash,validation_hash,training_kind,development_sample_n,validation_sample_n,validation_pass,created_at) SELECT a.artifact_hash,a.candidate_id,a.target_issue,a.delivery_hash,a.payload_hash,a.development_receipt_hash,a.validation_hash,a.training_kind,a.development_sample_n,a.validation_sample_n,a.validation_pass,a.created_at FROM r952_artifact a JOIN research_development_receipt_v2 d ON d.artifact_hash=a.artifact_hash WHERE NOT EXISTS(SELECT 1 FROM research_artifact_identity_v2 i WHERE i.artifact_hash=a.artifact_hash)";
+ private static final String REGISTER="INSERT INTO research_artifact_identity_v2(artifact_hash,candidate_id,target_issue,delivery_hash,payload_hash,development_receipt_hash,validation_hash,training_kind,development_sample_n,validation_sample_n,validation_pass,created_at) SELECT artifact_hash,candidate_id,target_issue,delivery_hash,payload_hash,development_receipt_hash,validation_hash,training_kind,development_sample_n,validation_sample_n,validation_pass,created_at FROM r952_artifact WHERE artifact_hash=? AND training_kind='DEVELOPMENT_AST3' AND validation_pass=1";
+ private static final String[] REBUILD={"DROP TRIGGER IF EXISTS cp8_development_receipt_identity","DROP TRIGGER IF EXISTS cp8_development_receipt_no_replace","DROP TRIGGER IF EXISTS cp8_development_receipt_immutable","DROP TRIGGER IF EXISTS cp8_development_receipt_permanent","CREATE TABLE research_development_receipt_cp12_rebuild(\n receipt_hash TEXT PRIMARY KEY CHECK(length(receipt_hash)=64),\n artifact_hash TEXT NOT NULL UNIQUE REFERENCES research_artifact_identity_v2(artifact_hash),\n protocol_hash TEXT NOT NULL UNIQUE REFERENCES research_training_protocol_v2(protocol_hash),\n validation_hash TEXT NOT NULL CHECK(length(validation_hash)=64),\n receipt_json TEXT NOT NULL CHECK(length(CAST(receipt_json AS BLOB)) BETWEEN 2 AND 8192),\n validation_json TEXT NOT NULL CHECK(length(CAST(validation_json AS BLOB)) BETWEEN 2 AND 16384),\n created_at INTEGER NOT NULL)","INSERT INTO research_development_receipt_cp12_rebuild SELECT * FROM research_development_receipt_v2","DROP TABLE research_development_receipt_v2","ALTER TABLE research_development_receipt_cp12_rebuild RENAME TO research_development_receipt_v2"};
+ private static final String[] GUARDS={"CREATE TRIGGER IF NOT EXISTS cp12_artifact_identity_immutable BEFORE UPDATE ON research_artifact_identity_v2 BEGIN SELECT RAISE(ABORT,'CP12_ARTIFACT_IDENTITY_IMMUTABLE'); END","CREATE TRIGGER IF NOT EXISTS cp12_artifact_identity_no_delete BEFORE DELETE ON research_artifact_identity_v2 BEGIN SELECT RAISE(ABORT,'CP12_ARTIFACT_IDENTITY_PERMANENT'); END","CREATE TRIGGER IF NOT EXISTS cp12_artifact_identity_no_replace BEFORE INSERT ON research_artifact_identity_v2 WHEN EXISTS(SELECT 1 FROM research_artifact_identity_v2 WHERE artifact_hash=NEW.artifact_hash OR delivery_hash=NEW.delivery_hash) BEGIN SELECT RAISE(ABORT,'CP12_ARTIFACT_IDENTITY_DUPLICATE'); END","CREATE TRIGGER IF NOT EXISTS cp8_development_receipt_identity\n BEFORE INSERT ON research_development_receipt_v2\n WHEN NOT EXISTS(SELECT 1 FROM research_artifact_identity_v2 a\n JOIN research_training_protocol_v2 p ON p.candidate_id=a.candidate_id\n WHERE a.artifact_hash=NEW.artifact_hash AND p.protocol_hash=NEW.protocol_hash\n AND a.training_kind='DEVELOPMENT_AST3' AND a.validation_pass=1\n AND a.validation_sample_n=p.validation_n AND a.development_sample_n=p.train_n\n AND a.development_receipt_hash=NEW.receipt_hash AND a.validation_hash=NEW.validation_hash)\n BEGIN SELECT RAISE(ABORT,'CP8_DEVELOPMENT_RECEIPT_IDENTITY'); END","CREATE TRIGGER IF NOT EXISTS cp8_development_receipt_no_replace\n BEFORE INSERT ON research_development_receipt_v2\n WHEN EXISTS(SELECT 1 FROM research_development_receipt_v2\n WHERE receipt_hash=NEW.receipt_hash OR artifact_hash=NEW.artifact_hash OR protocol_hash=NEW.protocol_hash)\n BEGIN SELECT RAISE(ABORT,'CP8_DEVELOPMENT_RECEIPT_DUPLICATE'); END","CREATE TRIGGER IF NOT EXISTS cp8_development_receipt_immutable BEFORE UPDATE ON research_development_receipt_v2 BEGIN SELECT RAISE(ABORT,'CP8_DEVELOPMENT_RECEIPT_IMMUTABLE'); END","CREATE TRIGGER IF NOT EXISTS cp8_development_receipt_permanent BEFORE DELETE ON research_development_receipt_v2 BEGIN SELECT RAISE(ABORT,'CP8_DEVELOPMENT_RECEIPT_PERMANENT'); END"};
+}
