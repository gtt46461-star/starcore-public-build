+package com.ethk3.novaonepro.r952;
+import android.database.Cursor;import android.database.sqlite.SQLiteDatabase;import java.util.*;import com.ethk3.novaonepro.*;
+/** Exact immutable Matrix endpoint for staged certificate external gates; never rewinds the producer checkpoint. */
+public final class MatrixEvidenceReadCP12 {
+ private MatrixEvidenceReadCP12(){}
+ public static final class View {public final MatrixProjectionCP12.Spec spec;public final MatrixSnapshotBusR952.CheckpointCP4 checkpoint;public final List<MatrixProjectionCP12.Sample> samples;public final String sourceFence,proof;public final boolean replayed;private View(MatrixProjectionCP12.Spec spec,MatrixSnapshotBusR952.CheckpointCP4 cp,MatrixProjectionCP12.State state,String fence,boolean replayed){this.spec=spec;checkpoint=cp;samples=state.samplesCopy();sourceFence=fence;this.replayed=replayed;proof=MatrixProjectionCP12.hash("CP12_MATRIX_EVIDENCE_VIEW|"+spec.matrixId+'|'+cp.payloadHash+'|'+cp.version+'|'+cp.throughIssue+'|'+cp.lastReceipt+'|'+fence+'|'+replayed);}}
+ public static View readAtCP12(SQLiteDatabase db,MatrixProjectionCP12.Spec spec,String through){
+  if(db.inTransaction())throw new IllegalStateException("MATRIX_EVIDENCE_PREPARE_IN_WRITER");if(spec.window!=300||!TargetIssueResolver.isValid(through))throw new IllegalArgumentException("MATRIX_EVIDENCE_SCOPE");String before=revisionFenceCP12(db);MatrixSnapshotBusR952.CheckpointCP4 cp=MatrixSnapshotBusR952.readAtCP4(db,spec.matrixId,spec.manifest,TargetIssueResolver.next(through).targetIssue);MatrixProjectionCP12.State state;boolean replayed;
+  if(cp!=null&&cp.throughIssue.equals(through)){if(!cp.schemaHash.equals(MatrixProjectionCP12.SCHEMA_HASH))throw new IllegalStateException("MATRIX_EVIDENCE_SCHEMA");state=MatrixProjectionCP12.decode(spec,cp.payload());replayed=false;}
+  else{List<Input> rows=inputs(db,spec,through);if(rows.isEmpty()||!rows.get(rows.size()-1).issue.equals(through))return null;state=MatrixProjectionCP12.empty(spec);for(Input row:rows)MatrixProjectionCP12.apply(state,row.ordinal,MatrixProjectionCP12.sampleFromBytes(row.payload),null);cp=new MatrixSnapshotBusR952.CheckpointCP4(spec.type.name(),spec.partition,300,spec.manifest,MatrixProjectionCP12.SCHEMA_HASH,0,through,rows.get(rows.size()-1).receipt,state.samples(),MatrixProjectionCP12.encode(state));replayed=true;}
+  if(!before.equals(revisionFenceCP12(db)))throw new IllegalStateException("MATRIX_EVIDENCE_CHANGED_DURING_PREPARE");return new View(spec,cp,state,replayed?before:"",replayed);
+ }
+ public static String revisionFenceCP12(SQLiteDatabase db){try(Cursor c=db.rawQuery("SELECT COUNT(*),COALESCE(MAX(generation),0) FROM research_row_revision_v2 WHERE source_table IN('research_matrix_input_cp12','research_projection_ack_v2')",null)){if(!c.moveToFirst())throw new IllegalStateException("MATRIX_EVIDENCE_REVISION");return MatrixProjectionCP12.hash("CP12_MATRIX_EVIDENCE_REVISION|"+c.getLong(0)+'|'+c.getLong(1));}}
+ public static boolean fenceIdentityCP12(SQLiteDatabase db,String id,String manifest,long version,String payloadHash,String through,String receipt,String schema,String sourceFence,boolean replayed){if(!db.inTransaction())throw new IllegalStateException("MATRIX_EVIDENCE_FENCE_TX");if(replayed)return sourceFence.equals(revisionFenceCP12(db));try(Cursor c=db.rawQuery("SELECT feature_manifest_hash,version,payload_hash,through_issue,last_receipt,schema_hash FROM research_matrix_checkpoint_v2 WHERE matrix_id=?",new String[]{id})){return c.moveToFirst()&&manifest.equals(c.getString(0))&&version==c.getLong(1)&&payloadHash.equals(c.getString(2))&&through.equals(c.getString(3))&&receipt.equals(c.getString(4))&&schema.equals(c.getString(5));}}
+ private static final class Input{String issue,receipt;long ordinal;byte[] payload;}
+ private static List<Input> inputs(SQLiteDatabase db,MatrixProjectionCP12.Spec spec,String through){List<Input> out=new ArrayList<>();try(Cursor c=db.rawQuery("SELECT i.source_issue,i.source_receipt_hash,i.source_ordinal,i.input_hash,i.proof_hash,i.input_payload,a.result_hash,a.through_issue FROM research_matrix_input_cp12 i JOIN research_projection_ack_v2 a ON a.consumer=? AND a.source_hash=i.source_receipt_hash WHERE i.matrix_id=? AND i.source_issue<=? AND i.state='DONE' ORDER BY i.source_ordinal DESC,i.source_receipt_hash DESC LIMIT 300",new String[]{"MATRIX_CP4/"+spec.matrixId,spec.matrixId,through})){while(c.moveToNext()){Input row=new Input();row.issue=c.getString(0);row.receipt=c.getString(1);row.ordinal=c.getLong(2);row.payload=c.getBlob(5);String expected=MatrixProjectionCP12.hash("CP12_MATRIX_INPUT|"+spec.matrixId+'|'+row.issue+'|'+row.ordinal+'|'+row.receipt+'|'+c.getString(4)+'|'+MatrixProjectionCP12.bytesHash(row.payload));if(!expected.equals(c.getString(3))||!c.getString(6).matches("[0-9a-f]{64}")||TargetIssueResolver.compare(c.getString(7),row.issue)<0)throw new IllegalStateException("MATRIX_EVIDENCE_INPUT_PROOF");out.add(row);}}Collections.reverse(out);return out;}
+}
