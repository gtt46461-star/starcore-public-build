+public static void freezeReadinessSnapshotCP4(com.ethk3.novaonepro.ReportReadContextCP4 report, com.ethk3.novaonepro.ReportTextCP12 b,com.ethk3.novaonepro.ReportReadContextCP4 store) {
+        try(Cursor c=report.select("SELECT c.candidate_id,COALESCE(a.numeric_updates,0),"
+                +"(SELECT COUNT(*) FROM r952_research_outbox o WHERE o.candidate_id=c.candidate_id AND o.state NOT IN ('COMPLETED','DEPENDENCY_RETIRED')),"
+                +"(SELECT COUNT(*) FROM r952_candidate_predraw p WHERE p.candidate_id=c.candidate_id AND p.settled=0 AND p.proof_error=''),"
+                +"(SELECT COUNT(*) FROM r967_frozen_candidate_all f WHERE f.learner_id=c.candidate_id),c.state,"
+                +"(SELECT COUNT(*) FROM r952_candidate_predraw p WHERE p.candidate_id=c.candidate_id AND p.proof_error<>'')"
+                +" FROM r952_candidate c LEFT JOIN r952_learning_cursor l ON l.consumer_id=('R952:'||c.candidate_id)"
+                +" LEFT JOIN r952_artifact a ON a.artifact_hash=l.artifact_hash AND a.candidate_id=c.candidate_id"
+                +" ORDER BY c.candidate_id LIMIT 3",null)) {
+            while(c.moveToNext()) {
+                String reason=c.getInt(4)>0?"FROZEN_VERSIONS_SEPARATE_FROM_CONTINUOUS_TRAINING":
+                        "QUARANTINED".equals(c.getString(5))||"QUALITY_PRUNED".equals(c.getString(5))?"CANDIDATE_INELIGIBLE":
+                        c.getInt(1)<FrozenCandidateAdapterR958.MIN_TRAINING?"WAIT_NUMERIC_TRAINING":
+                        c.getInt(2)>0?"WAIT_TRAINING_OUTBOX":c.getInt(3)>0?"WAIT_UNSETTLED_LABELS":"AWAIT_ATOMIC_PREDRAW_FREEZE_CHECKS";
+                b.append("\nFREEZE_READINESS|candidate=").append(c.getString(0)).append("|numericUpdates=").append(c.getInt(1))
+                        .append("|requiredUpdates=").append(FrozenCandidateAdapterR958.MIN_TRAINING)
+                        .append("|pendingTraining=").append(c.getInt(2)).append("|unsettledPredraw=").append(c.getInt(3))
+                        .append("|rejectedPredraw=").append(c.getInt(6))
+                        .append("|reason=").append(reason).append("|certificateGrantedByReport=0");
+            }
+        }catch(RuntimeException e){throw new com.ethk3.novaonepro.ReportReadContextCP4.ReportReadFailureCP4("REPORT_QUERY_OR_FORMAT_FAILED",e);}
+    }
