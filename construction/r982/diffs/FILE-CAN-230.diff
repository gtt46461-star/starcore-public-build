+        try(Cursor c=report.select("SELECT candidate_key,study_hash,captured_n,settled_n,state,first_issue FROM "
+                +com.ethk3.novaonepro.CandidateCalibrationR932.STUDY+" ORDER BY first_issue DESC,candidate_key LIMIT 96",null)){
